<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
   
       <HBox alignment="CENTER_LEFT" spacing="10.0">
      <children>
              <Label style="-fx-font-weight: bold;" text="Product Details">
                  <font>
                      <Font size="24.0" />
                  </font>
              </Label>
              <Region HBox.hgrow="ALWAYS" />
              <Button style="-fx-background-color: #2ecc71; -fx-text-fill: white;" text="Save Product" />
      </children>
       </HBox>
   
       <Separator />
   
       <GridPane hgap="15.0" prefHeight="184.0" prefWidth="760.0" vgap="10.0">
           <columnConstraints>
               <ColumnConstraints minWidth="100.0" prefWidth="150.0" />
               <ColumnConstraints />
           </columnConstraints>
           
           <children>
               <Label text="Product Name:" GridPane.rowIndex="0" />
               <TextField fx:id="nameField" promptText="e.g. Premium Cotton T-Shirt" GridPane.columnIndex="1" GridPane.rowIndex="0" />
   
               <Label text="Quantity:" GridPane.rowIndex="1" />
   
               <Label text="Description:" GridPane.rowIndex="4" />
               <TextArea fx:id="descriptionArea" prefHeight="80.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Barecode" GridPane.rowIndex="3" />
           </children>
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
       </GridPane>
   
       <VBox spacing="10.0">
      <children>
              <HBox alignment="CENTER_LEFT" />
      
              <TableView fx:id="variantTable" prefHeight="300.0">
                  <columns>
                      <TableColumn fx:id="colSku" prefWidth="120.0" text="SKU" />
                      <TableColumn fx:id="colname" prefWidth="100.0" text="Product Name" />
                      <TableColumn fx:id="colStock" prefWidth="80.0" text="Quantity" />
                      <TableColumn fx:id="coldes" prefWidth="100.0" text="Description" />
                      <TableColumn fx:id="colAction" prefWidth="100.0" text="Actions" />
                  </columns>
                  <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
              </TableView>
      </children>
       </VBox>
   </children>
</VBox>
