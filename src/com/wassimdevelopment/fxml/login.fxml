<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.wassimdevelopment.LoginController">
   <children>
      <ComboBox fx:id="nomComboBox" editable="true" layoutX="315.0" layoutY="143.0" prefHeight="26.0" prefWidth="216.0" stylesheets="@../styles/combobox.css" />
      <PasswordField fx:id="passTF" layoutX="315.0" layoutY="207.0" prefHeight="26.0" prefWidth="216.0" stylesheets="@../styles/textfield.css" />
      <Button layoutX="407.0" layoutY="279.0" mnemonicParsing="false" onAction="#login" prefHeight="26.0" prefWidth="130.0" style="-fx-background-color: #5A38FD#5A38FD;" text="Login" textFill="WHITE" />
      <AnchorPane prefHeight="400.0" prefWidth="267.0" style="-fx-background-color: #5A38FD#5A38FD;">
         <children>
            <Label layoutX="34.0" layoutY="135.0" text="Bienvenue." textFill="WHITE">
               <font>
                  <Font name="Arial" size="30.0" />
               </font>
            </Label>
            <Label layoutX="93.0" layoutY="183.0" text="Identifiez-vous" textFill="#c3c3c3">
               <font>
                  <Font size="19.0" />
               </font>
            </Label>
         </children>
      </AnchorPane>
      <Label layoutX="315.0" layoutY="124.0" text="Username" />
      <Label layoutX="316.0" layoutY="186.0" text="Password" />
      <Label fx:id="loginErrorMsg" layoutX="272.0" layoutY="248.0" prefHeight="16.0" prefWidth="302.0" text="Nom d'utilisateur / mot de passe incorrect !" textFill="RED" visible="false" />
   </children>
</AnchorPane>
